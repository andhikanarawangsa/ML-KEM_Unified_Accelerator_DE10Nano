// DFD Level 3 -- process 4.1 Compute Lane 0 (rtl/mlkem_pe.v); 4.2-4.4 are identical
// Yourdon/DeMarco child diagram: the rounded frame is the boundary of parent process 4.1.
// Arrows crossing the frame are the parent's flows (balanced with Level 2); source/sink named in the label.
digraph dfd3_pe {
    graph [layout=neato, splines=line, fontname="Helvetica-Bold", fontsize=18, labelloc=t, outputorder=nodesfirst,
           label="DFD Level 3 - Process 4.1 Compute Lane (mlkem_pe.v; identical for 4.2-4.4)"];
    node  [fontname="Helvetica", fontsize=14, margin=0.04];
    edge  [fontname="Helvetica", fontsize=12];

    frame [shape=box, style=rounded, color="#999999", label="", pos="3.85,6.0!", width=8.9, height=10.4];
    title [shape=plaintext, label="4.1 Compute Lane", fontname="Helvetica-Oblique", fontcolor="#555555", pos="0.5,10.9!"];

    node [shape=circle, width=1.4, fixedsize=true];
    p411 [label="4.1.1\nLatch\nOperands",        pos="3.5,10!"];
    p412 [label="4.1.2\nSelect\nOperands", pos="1.5,6.6!"];
    p413 [label="4.1.3\nModular\nMultiply",      pos="1.5,4.2!"];
    p414 [label="4.1.4\nDelay Side\nOperands",   pos="5.5,5.4!"];
    p415 [label="4.1.5\nCombine &\nAccumulate",  pos="3.5,2.0!"];

    node [shape=none, width=0, fixedsize=false];
    d7 [pos="3.5,8.4!", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D7 &nbsp; PE Operand Registers<BR/>(a, b, c, d, z, mode, phase)</TD></TR></TABLE>>];
    d8 [pos="6.75,2.0!", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D8 &nbsp; PWM Accumulator<BR/>(acc0, acc1)</TD></TR></TABLE>>];

    node [shape=point, width=0.01, style=invis];
    i_ops [pos="3.5,12!"];
    o_res [pos="3.5,-0.6!"];
    w1 [pos="0.0,4.2!"]; w2 [pos="0.0,6.6!"];

    i_ops -> p411;
    p411 -> d7 [dir=both];
    d7 -> p412;
    d7 -> p414;
    p412 -> p413;
    p413 -> w1 [arrowhead=none];          // product feedback for PWM phase 3, routed along the left edge
    w1 -> w2   [arrowhead=none];
    w2 -> p412;
    p413 -> p415;
    p414 -> p415;
    p415 -> d8 [dir=both];
    p415 -> o_res;

    node [shape=plaintext, style=solid, width=0, height=0, margin=0, fontsize=12, fixedsize=false];
    l_ops  [pos="4.55,11.6!", label="a, b, c, d, z,\nmode (from 3.0)"];
    l_ph   [pos="4.55,9.2!",  label="operands,\nphase 0..4"];
    l_sel  [pos="1.75,7.85!", label="a, b, c, d, z,\nmode, phase"];
    l_side [pos="5.55,7.1!",  label="a, b, mode, phase"];
    l_xy   [pos="3.35,5.4!",  label="x, y  (FNTT: b, z | INTT: b-a, z\nSCALE: a, z | PWM ph0-4: b,d  a,c\na,d  r,z  b,c)"];
    l_fb   [pos="-0.45,5.4!", label="r\n(PWM ph3:\na1*b1)"];
    l_r    [pos="2.0,2.85!",  label="r = x*y\nmod q"];
    l_al   [pos="5.25,3.6!",  label="a, b, mode,\nphase (aligned)"];
    l_pp   [pos="5.05,2.3!",  label="partial\nproducts"];
    l_out  [pos="5.8,-0.15!", label="y0, y1 (to 3.0)\nFNTT: a+r, a-r | INTT: a+b, r | SCALE: r\nADD: a+b | SUB: a-b | PWM: acc0+r, acc1+r"];
}
