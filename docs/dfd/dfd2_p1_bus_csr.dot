// DFD Level 2 -- process 1.0 Handle Bus Access (rtl/mlkem_csr.v)
// Yourdon/DeMarco child diagram: the rounded frame is the boundary of parent process 1.0.
// Arrows crossing the frame are the parent's flows (balanced with Level 1); source/sink named in the label.
// Layout is pinned (pos = "x,y!" in inches): nodes, then flow labels (l_*) placed beside their arrows.
digraph dfd2_p1 {
    graph [layout=neato, splines=line, fontname="Helvetica-Bold", fontsize=18, labelloc=t, outputorder=nodesfirst,
           label="DFD Level 2 - Process 1.0 Handle Bus Access (mlkem_csr.v)"];
    node  [fontname="Helvetica", fontsize=14, margin=0.04];
    edge  [fontname="Helvetica", fontsize=12];

    frame [shape=box, style=rounded, color="#999999", label="", pos="4.5,7.2!", width=9.4, height=8.0];
    title [shape=plaintext, label="1.0 Handle Bus Access", fontname="Helvetica-Oblique", fontcolor="#555555", pos="0.95,10.9!"];

    node [shape=circle, width=1.4, fixedsize=true];
    p11 [label="1.1\nDecode\nAddress",            pos="4,10!"];
    p12 [label="1.2\nUpdate\nRegisters",          pos="1.3,7.6!"];
    p13 [label="1.3\nBuild Read\nResponse",       pos="7,7.6!"];
    p14 [label="1.4\nLatch Done\n& Raise IRQ",    pos="7.9,4.6!"];

    node [shape=none, width=0, fixedsize=false];
    d1 [pos="4,4.6!", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D1 &nbsp; Control/Status Registers<BR/>(OP, SLOT, IRQ_EN, DONE, ERR)</TD></TR></TABLE>>];

    node [shape=point, width=0.01, style=invis];
    i_bus   [pos="4,11.9!"];
    i_rdw   [pos="7,11.9!"];
    o_host  [pos="-1.4,10!"];
    o_start [pos="-1.4,7.6!"];
    i_stat  [pos="11.2,8.4!"];
    o_bus   [pos="11.2,7.0!"];
    o_irq   [pos="11.2,4.6!"];
    o_cfg   [pos="4,2.4!"];
    i_done  [pos="7.9,2.4!"];

    i_bus  -> p11;
    i_rdw  -> p13;
    p11 -> o_host;
    p11 -> p12;
    p11 -> p13;
    p12 -> o_start;
    p12 -> d1;
    d1  -> p13;
    d1  -> o_cfg;
    p14 -> d1 [dir=both];
    i_done -> p14;
    p14 -> o_irq;
    i_stat -> p13;
    p13 -> o_bus;

    node [shape=plaintext, style=solid, width=0, height=0, margin=0, fontsize=12, fixedsize=false];
    l_bus   [pos="5.1,11.5!",  label="Avalon-MM addr, data,\nread/write (from HPS)"];
    l_rdw   [pos="7.85,11.5!", label="host read word\n(from 2.0)"];
    l_host  [pos="1.2,10.3!",  label="host word access (to 2.0)\nonly when BUSY = 0"];
    l_reg   [pos="1.95,9.1!",  label="register write,\naccess violation"];
    l_rsel  [pos="6.0,9.3!",   label="read select"];
    l_start [pos="-0.95,7.85!", label="start command\n(to 3.0)"];
    l_d1w   [pos="1.45,5.9!",  label="OP, SLOT, IRQ_EN,\nDONE/ERR clear,\nERR set"];
    l_rv    [pos="6.1,5.9!",   label="register values"];
    l_de    [pos="6.65,4.85!", label="DONE, ERR"];
    l_cfg   [pos="4.85,2.75!", label="op, slots, scale_en\n(to 3.0)"];
    l_done  [pos="8.75,2.75!", label="done/err status\n(from 3.0)"];
    l_irq   [pos="10.25,4.82!", label="completion\ninterrupt (to GIC)"];
    l_stat  [pos="10.2,8.48!", label="busy status, cycles\n(from 3.0)"];
    l_bus2  [pos="10.2,6.78!", label="read data (to HPS)\n0xBAD0BAD0 if blocked"];
}
