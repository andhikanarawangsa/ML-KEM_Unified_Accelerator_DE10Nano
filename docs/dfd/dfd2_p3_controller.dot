// DFD Level 2 -- process 3.0 Schedule Operation (rtl/mlkem_ctrl.v)
// Yourdon/DeMarco child diagram: the rounded frame is the boundary of parent process 3.0.
// Arrows crossing the frame are the parent's flows (balanced with Level 1); source/sink named in the label.
// Layout is pinned (pos = "x,y!" in inches): nodes, then flow labels (l_*) placed beside their arrows.
digraph dfd2_p3 {
    graph [layout=neato, splines=line, fontname="Helvetica-Bold", fontsize=18, labelloc=t, outputorder=nodesfirst,
           label="DFD Level 2 - Process 3.0 Schedule Operation (mlkem_ctrl.v)"];
    node  [fontname="Helvetica", fontsize=14, margin=0.04];
    edge  [fontname="Helvetica", fontsize=12];

    // boundary of parent process 3.0
    frame [shape=box, style=rounded, color="#999999", label="", pos="3.4,5.75!", width=9.6, height=13.0];
    title [shape=plaintext, label="3.0 Schedule Operation", fontname="Helvetica-Oblique", fontcolor="#555555", pos="0.3,12!"];

    // processes
    node [shape=circle, width=1.4, fixedsize=true];
    p31 [label="3.1\nSequence\nOperation",      pos="4,11!"];
    p32 [label="3.2\nGenerate\nAddresses",      pos="4,8.2!"];
    p33 [label="3.3\nRoute\nOperands",          pos="4,6.2!"];
    p34 [label="3.4\nStage PWM\nOperands",      pos="6.6,4.4!"];
    p35 [label="3.5\nQueue Write\nDescriptors", pos="4,3.2!"];
    p36 [label="3.6\nPack &\nWrite Back",       pos="4,0.4!"];

    // data stores
    node [shape=none, width=0, fixedsize=false];
    d1 [pos="0.9,11!",  label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D1 &nbsp; Control/Status<BR/>Registers</TD></TR></TABLE>>];
    d4 [pos="4,9.6!",   label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D4 &nbsp; Operation State (op, slots, layer,<BR/>group, beat, outstanding, cycles)</TD></TR></TABLE>>];
    d3 [pos="1.2,6.2!", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D3 &nbsp; Twiddle<BR/>Factor ROM</TD></TR></TABLE>>];
    d5 [pos="6.6,2.7!", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D5 &nbsp; PWM Staging<BR/>Registers</TD></TR></TABLE>>];
    d6 [pos="4,1.8!",   label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD SIDES="TB">D6 &nbsp; Write-Descriptor FIFO</TD></TR></TABLE>>];

    // boundary end-points (outside the frame) and routing waypoints
    node [shape=point, width=0.01, style=invis];
    i_start [pos="4,13.1!"];
    o_busy  [pos="6.9,12.75!"];
    o_stat  [pos="9.2,11!"];
    o_rdcmd [pos="9.2,8.2!"];
    i_rd    [pos="9.2,6.2!"];
    o_ops1  [pos="9.2,5.2!"];
    o_ops2  [pos="9.2,4.4!"];
    i_res   [pos="9.2,0.4!"];
    o_wrcmd [pos="4,-1.3!"];
    w1 [pos="-0.7,0.4!"]; w2 [pos="-0.7,9.6!"];

    // flows (labels are the l_* nodes below)
    i_start -> p31;
    d1  -> p31;
    p31 -> o_stat ;
    p31 -> o_busy;
    p31 -> d4 [dir=both];
    d4  -> p32;
    p32 -> o_rdcmd;
    p32 -> p33;
    i_rd -> p33;
    d3  -> p33;
    p33 -> o_ops1;
    p33 -> p34;
    p34 -> o_ops2;
    p34 -> d5 [dir=both];
    p33 -> p35;
    p34 -> p35;
    p35 -> d6;
    d6  -> p36;
    i_res -> p36;
    p36 -> o_wrcmd;
    p36 -> w1 [arrowhead=none];       // write-back completion, routed along the left edge
    w1  -> w2 [arrowhead=none];
    w2  -> d4;

    // flow labels
    node [shape=plaintext, style=solid, width=0, height=0, margin=0, fontsize=12, fixedsize=false];
    l_start [pos="2.95,12.6!",  label="start command (from 1.0)"];
    l_busy  [pos="7.95,12.5!",  label="busy status (to 2.0)"];
    l_cfg   [pos="2.45,11.25!",  label="op, slots, scale_en"];
    l_stat  [pos="6.95,11.3!",  label="busy/done/err status,\ncycles (to 1.0)"];
    l_ost   [pos="4.55,10.1!",  label="op state"];
    l_lgb   [pos="4.9,9.08!",   label="layer, group, beat"];
    l_rdcmd [pos="6.95,8.42!",  label="bank read cmds (to 2.0)"];
    l_xbar  [pos="5.0,7.2!",    label="crossbar select,\nwrite descriptor"];
    l_rd    [pos="6.95,6.42!",  label="bank read words (from 2.0)"];
    l_zeta  [pos="2.6,6.42!",   label="zeta"];
    l_ops1  [pos="7.6,5.78!",   label="operand lanes (to 4.0)"];
    l_beat  [pos="4.95,4.95!",  label="PWM beat"];
    l_wdesc [pos="3.25,4.7!",   label="write descriptor"];
    l_ops2  [pos="8.4,4.15!",  label="PWM operand lanes (to 4.0)"];
    l_pairs [pos="7.4,3.32!",   label="operand pairs"];
    l_pdesc [pos="5.55,3.4!",   label="PWM\ndescriptor"];
    l_push  [pos="4.4,2.25!",   label="push"];
    l_head  [pos="4.75,1.32!",  label="head descriptor"];
    l_res   [pos="6.95,0.62!",  label="result lanes (from 4.0)"];
    l_wrcmd [pos="5.0,-1.0!",   label="bank write cmds\n(to 2.0)"];
    l_wb    [pos="0.25,5.0!",   label="write-back count\n(outstanding - 1)"];
}
