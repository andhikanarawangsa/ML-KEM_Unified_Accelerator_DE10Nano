// DFD Level 2 -- process 4.0 Compute Polynomial Arithmetic (rtl/mlkem_arith_core.v)
// Yourdon/DeMarco child diagram: the rounded frame is the boundary of parent process 4.0.
// Arrows crossing the frame are the parent's flows (balanced with Level 1); source/sink named in the label.
// The 4 PEs run in lock-step; mode is broadcast to all lanes.
digraph dfd2_p4 {
    graph [layout=neato, splines=line, fontname="Helvetica-Bold", fontsize=18, labelloc=t, outputorder=nodesfirst,
           label="DFD Level 2 - Process 4.0 Compute Polynomial Arithmetic (mlkem_arith_core.v)"];
    node  [fontname="Helvetica", fontsize=14, margin=0.04];
    edge  [fontname="Helvetica", fontsize=12];

    frame [shape=box, style=rounded, color="#999999", label="", pos="3,3.9!", width=4.6, height=6.4];
    title [shape=plaintext, label="4.0 Compute Polynomial Arithmetic", fontname="Helvetica-Oblique", fontcolor="#555555", pos="3,6.8!"];

    node [shape=circle, width=1.25, fixedsize=true];
    p41 [label="4.1\nCompute\nLane 0", pos="3,5.7!"];
    p42 [label="4.2\nCompute\nLane 1", pos="3,4.3!"];
    p43 [label="4.3\nCompute\nLane 2", pos="3,2.9!"];
    p44 [label="4.4\nCompute\nLane 3", pos="3,1.5!"];

    node [shape=point, width=0.01, style=invis];
    i0 [pos="-1.6,5.7!"]; i1 [pos="-1.6,4.3!"]; i2 [pos="-1.6,2.9!"]; i3 [pos="-1.6,1.5!"];
    o0 [pos="7.6,5.7!"];  o1 [pos="7.6,4.3!"];  o2 [pos="7.6,2.9!"];  o3 [pos="7.6,1.5!"];

    i0 -> p41; i1 -> p42; i2 -> p43; i3 -> p44;
    p41 -> o0; p42 -> o1; p43 -> o2; p44 -> o3;

    node [shape=plaintext, style=solid, width=0, height=0, margin=0, fontsize=12, fixedsize=false];
    li0 [pos="-0.55,6.0!", label="a,b,c,d,z [11:0],\nmode"];
    li1 [pos="-0.55,4.6!", label="a,b,c,d,z [23:12],\nmode"];
    li2 [pos="-0.55,3.2!", label="a,b,c,d,z [35:24],\nmode"];
    li3 [pos="-0.55,1.8!", label="a,b,c,d,z [47:36],\nmode"];
    lo0 [pos="6.55,5.92!",  label="y0, y1 [11:0]"];
    lo1 [pos="6.55,4.52!", label="y0, y1 [23:12]"];
    lo2 [pos="6.55,3.12!", label="y0, y1 [35:24]"];
    lo3 [pos="6.55,1.72!", label="y0, y1 [47:36]"];
    lsrc [pos="-0.55,0.55!", label="(from 3.0)", fontname="Helvetica-Oblique"];
    ldst [pos="6.55,0.55!",  label="(to 3.0)",   fontname="Helvetica-Oblique"];
}
